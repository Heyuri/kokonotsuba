	<div class="tableViewportWrapper">
		<table class="postlists reportStatsTable">
			<thead>
				<tr>
					<th class="colStat">{$TH_STAT}</th>
					<th class="colCount">{$TH_COUNT}</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td class="colStat">{$LABEL_TOTAL}</td>
					<td class="colCount reportStatTotal">{$REPORT_COUNT}</td>
				</tr>
				<tr class="reportRowPending">
					<td class="colStat">{$LABEL_PENDING}</td>
					<td class="colCount reportStatPending">{$PENDING_COUNT}</td>
				</tr>
				<tr class="reportRowApproved">
					<td class="colStat">{$LABEL_APPROVED}</td>
					<td class="colCount reportStatApproved">{$APPROVED_COUNT}</td>
				</tr>
				<tr class="reportRowDismissed">
					<td class="colStat">{$LABEL_DISMISSED}</td>
					<td class="colCount reportStatDismissed">{$DISMISSED_COUNT}</td>
				</tr>
			</tbody>
		</table>
	</div>
