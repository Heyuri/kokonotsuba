# Kokonotsuba: the root includes, dotfiles, docs and every boardUID.ini are denied.
<FilesMatch "^(autoload|databaseSettings|databaseSettings\.example|paths|tables)\.php$|^\.|\.(md|ini)$|^LICENSE$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
